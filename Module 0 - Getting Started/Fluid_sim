### Variables
rho = 1000 #[kg/m^3]
m_plate = 10 #[kg/m^3]
g = 9.81 #[m/s^2]
y = [4] #[m]
x = [2] #[m]
z = [10] #[m]
V = x[0] * y[0] * z[0]
Q = [0]
h_t = [y[-1]]
y_n = [0]
y_p = [0]
theta = [0]
theta_d = [0]
alpha = [0]
alpha_d = [0]
W = [0]
t_i = [0.1] # Time step
time_total = [10] # Simulation time in seconds
t = [0] # List of time values in the simulation
w = [0] # angular velocity of door
q_t = [0] # flow rate
T = list() # Torque
T_time = [0] # Instantaneous torque
headers = ['Time [sec]', 'Theta [rad]', "T [N*m]" ]


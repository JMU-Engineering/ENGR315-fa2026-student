### Simulation

# Normalizing
t_aug = time_total[0]/t_i[0]

n = 0

for n in range(0, int(t_aug), 1):

    # De Normalizing
    t.append(n * t_i)
    
    # hieght
    y_n.append( y[-1] * (m.cos(theta[-1])))
    y_g = [y[-1] - y_n[-1]] 
    

    # Submerged Triangle
    y_s = h_t[-1]-y_g[-1]
    hypo_s = y_s / (m.cos(theta[-1]))
    
    # 
    A_s = hypo_s * z[-1]
    Ix = z[-1]*(hypo_s**2)/12
    
    # pressure
    P = rho*g*h_t[-1]

    # lenght
    y_pt = 0.5*y_s + Ix / (0.5 * y_s * A_s)
    y_p = y_pt + (y[0]-h_t[-1])
    x_p = y_p*m.tan(theta[-1])
    
    # area
    A_g = z[-1] * y_g[-1] 

    # flow rate
    h_t.append(h_t[-1] - (((t_i[-1]**2)) * (P * (A_s ** 2 )))/((V * rho) * (x[-1] * z[-1])))
    q_t.append(q_t[-1] + (P * (A_g ** 2) )/V*rho)

    # Volume
    V_triangle = 0.5 * y_n[-1] * z[-1] * m.sin(theta[-1])*y[-1]

    # force
    F_x = rho * g * y_pt * (h_t[-1]-y_g[-1]) * z[-1]
    F_py = rho * g * (h_t[-1] - y_g[-1]) * (z[-1] * y[-1]*m.sin(theta[-1]))
    F_pw = V_triangle * rho * g
    F_y = F_py - F_pw
    F_t = m.sqrt(F_x ** 2 + F_y ** 2)
    Angle_f = m.atan(F_y/F_x)

    # torque
    Tx = F_x * y_p
    Ty = F_y * x_p
    
    T.append(Tx + Ty)
    I = [0.3333333 * m_plate * y[-1] ** 2]
    T_time.append(T[-1])
    alpha.append(T[-1] / I[0])
    theta.append(w[-1] * t_i[-1] + 0.5 * alpha[-1] * (t_i[-1] ** 2))
    w.append(w[-1] + t_i[0]*alpha[-1])
    alpha_d.append(m.degrees(theta[-1]))

   
